+LOCAL int
+plextor_auth_begin(scgp)
+	SCSI	*scgp;
+{
+	Uchar	challenge[16];
+	Uchar	response[16];
+	int	ret;
+
+	/*
+	 * A previous interrupted operation may have left authentication open.
+	 * If D4 is rejected, close any stale session and retry once.
+	 */
+	ret = plextor_getauth(scgp, challenge, sizeof (challenge));
+	if (ret < 0) {
+		(void) plextor_disable(scgp);
+		ret = plextor_getauth(scgp, challenge, sizeof (challenge));
+	}
+	if (ret < 0)
+		return (ret);
+
+	plextor_auth_response(challenge, response);
+	ret = plextor_setauth(scgp, response, sizeof (response));
+	if (ret < 0)
+		(void) plextor_disable(scgp);
+
+	return (ret);
+}
