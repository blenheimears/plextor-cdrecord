+LOCAL UInt32_t
+plextor_auth_load_be32(p)
+	const Uchar *p;
+{
+    return ((UInt32_t)p[0] << 24) |
+           ((UInt32_t)p[1] << 16) |
+           ((UInt32_t)p[2] << 8) |
+           (UInt32_t)p[3];
+}
+
+LOCAL void
+plextor_auth_store_be32(p, x)
+	Uchar *p;
+	UInt32_t x;
+{
+    p[0] = (Uchar)(x >> 24);
+    p[1] = (Uchar)(x >> 16);
+    p[2] = (Uchar)(x >> 8);
+    p[3] = (Uchar)x;
+}
+
+LOCAL UInt32_t
+plextor_auth_bf_f(ctx, x)
+	const plextor_auth_blowfish_ctx *ctx;
+	UInt32_t x;
+{
+    UInt32_t y = ctx->s[0][(x >> 24) & 0xff] +
+                 ctx->s[1][(x >> 16) & 0xff];
+    y ^= ctx->s[2][(x >> 8) & 0xff];
+    y += ctx->s[3][x & 0xff];
+    return y;
+}
+
+LOCAL void
+plextor_auth_bf_encrypt_words(ctx, left, right)
+	const plextor_auth_blowfish_ctx *ctx;
+	UInt32_t *left;
+	UInt32_t *right;
+{
+    UInt32_t l = *left;
+    UInt32_t r = *right;
+    UInt32_t t;
+    unsigned i;
+
+    for (i = 0; i < 16; ++i) {
+        l ^= ctx->p[i];
+        r ^= plextor_auth_bf_f(ctx, l);
+        t = l; l = r; r = t;
+    }
+    {
+        t = l; l = r; r = t;
+    }
+    r ^= ctx->p[16];
+    l ^= ctx->p[17];
+
+    *left = l;
+    *right = r;
+}
+
+LOCAL void
+plextor_auth_bf_set_key(ctx, key)
+	plextor_auth_blowfish_ctx *ctx;
+	const Uchar *key;
+{
+    unsigned j = 0;
+    unsigned i;
+    unsigned n;
+    unsigned box;
+    UInt32_t w;
+    UInt32_t l = 0;
+    UInt32_t r = 0;
+
+    memcpy(ctx->p, plextor_auth_bf_init_p, sizeof(ctx->p));
+    memcpy(ctx->s, plextor_auth_bf_init_s, sizeof(ctx->s));
+
+    for (i = 0; i < 18; ++i) {
+        w = 0;
+        for (n = 0; n < 4; ++n) {
+            w = (w << 8) | key[j];
+            j = (j + 1) & 15;
+        }
+        ctx->p[i] ^= w;
+    }
+
+    for (i = 0; i < 18; i += 2) {
+        plextor_auth_bf_encrypt_words(ctx, &l, &r);
+        ctx->p[i] = l;
+        ctx->p[i + 1] = r;
+    }
+    for (box = 0; box < 4; ++box) {
+        for (i = 0; i < 256; i += 2) {
+            plextor_auth_bf_encrypt_words(ctx, &l, &r);
+            ctx->s[box][i] = l;
+            ctx->s[box][i + 1] = r;
+        }
+    }
+}
+
+LOCAL void
+plextor_auth_bf_decrypt_block(ctx, in, out)
+	const plextor_auth_blowfish_ctx *ctx;
+	const Uchar *in;
+	Uchar *out;
+{
+    UInt32_t l = plextor_auth_load_be32(in);
+    UInt32_t r = plextor_auth_load_be32(in + 4);
+    UInt32_t t;
+    int i;
+
+    for (i = 17; i > 1; --i) {
+        l ^= ctx->p[i];
+        r ^= plextor_auth_bf_f(ctx, l);
+        t = l; l = r; r = t;
+    }
+    {
+        t = l; l = r; r = t;
+    }
+    r ^= ctx->p[1];
+    l ^= ctx->p[0];
+
+    plextor_auth_store_be32(out, l);
+    plextor_auth_store_be32(out + 4, r);
+}
+
+/* PlexTools Professional XL 3.16 computes the protected-command response as:
+ *   key      = MD5(seed)
+ *   clear    = Blowfish-ECB-DECRYPT(challenge[0..7], key) ||
+ *              Blowfish-ECB-DECRYPT(challenge[8..15], key)
+ *   response = MD5(clear)
+ * The recovered transform matches all 43 captured Premium2 D4/D5 exchanges. */
+EXPORT void
+plextor_auth_response(challenge, response)
+	const Uchar *challenge;
+	Uchar *response;
+{
+    static const Uchar seed[16] = {
+        0x3d, 0x14, 0x4a, 0x9c, 0x2b, 0x4a, 0x53, 0x63,
+        0x25, 0x98, 0xf2, 0xa5, 0xc4, 0xad, 0x03, 0xcf
+    };
+    Uchar key[16];
+    Uchar clear[16];
+    plextor_auth_blowfish_ctx ctx;
+
+    plextor_auth_md5_16(seed, key);
+    plextor_auth_bf_set_key(&ctx, key);
+    plextor_auth_bf_decrypt_block(&ctx, challenge, clear);
+    plextor_auth_bf_decrypt_block(&ctx, challenge + 8, clear + 8);
+    plextor_auth_md5_16(clear, response);
+}
