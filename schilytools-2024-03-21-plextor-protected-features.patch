+/*
+ * Minimal MD5 + Blowfish implementation for the Plextor challenge-response
+ * protocol used by the Premium2, PX-755 and PX-760.
+ *
+ * Written for QPxTool and adapted for cdrecord.  This file is dedicated to
+ * the public domain.  To the extent that a public-domain dedication is not
+ * effective in a particular jurisdiction, permission is granted to anyone to
+ * use, copy, modify, publish, distribute, sublicense, and/or sell this software
+ * for any purpose, with or without fee and with or without attribution.
+ *
+ * This is intentionally not a general crypto library.  It implements only:
+ *   - MD5 of one 16-byte message (the only message size used here)
+ *   - Blowfish key expansion for a 16-byte key
+ *   - Blowfish ECB decryption of an 8-byte block
+ */
+#include <schily/mconfig.h>
+#include <schily/standard.h>
+#include <schily/utypes.h>
+#include <schily/string.h>
+
+#include "plextor_auth.h"
+
+LOCAL UInt32_t
+plextor_auth_rotl32(x, n)
+	UInt32_t x;
+	unsigned n;
+{
+    return (x << n) | (x >> (32 - n));
+}
+
+LOCAL UInt32_t
+plextor_auth_load_le32(p)
+	const Uchar *p;
+{
+    return (UInt32_t)p[0] |
+           ((UInt32_t)p[1] << 8) |
+           ((UInt32_t)p[2] << 16) |
+           ((UInt32_t)p[3] << 24);
+}
+
+LOCAL void
+plextor_auth_store_le32(p, x)
+	Uchar *p;
+	UInt32_t x;
+{
+    p[0] = (Uchar)x;
+    p[1] = (Uchar)(x >> 8);
+    p[2] = (Uchar)(x >> 16);
+    p[3] = (Uchar)(x >> 24);
+}
+
+/* MD5 for exactly one 16-byte input. */
