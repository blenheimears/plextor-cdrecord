+	if (plextor_auth_begin(scgp) < 0)
+		return (-1);
+
+	ret = drivemode_plextor_raw(scgp, bp, cnt, modecode, modeval);
+	eret = plextor_disable(scgp);
+
+	if (ret < 0)
+		return (ret);
+	if (eret < 0)
+		return (-1);
+	return (ret);
+}
