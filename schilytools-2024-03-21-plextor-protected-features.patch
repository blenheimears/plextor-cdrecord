+LOCAL BOOL
+mmc_plextor_needs_auth(scgp)
+	SCSI	*scgp;
+{
+	struct scsi_inquiry *ip;
+
+	if (!mmc_isplextor(scgp) || scgp->inq == NULL)
+		return (FALSE);
+	ip = scgp->inq;
+
+	/*
+	 * The late genuine Plextor generation protects vendor E9 feature
+	 * commands with a D4/D5 challenge-response exchange.
+	 */
+	if (strncmp(ip->inq_prod_ident, "CD-R   PREMIUM2", 15) == 0 ||
+	    strncmp(ip->inq_prod_ident, "DVDR   PX-755", 13) == 0 ||
+	    strncmp(ip->inq_prod_ident, "DVDR   PX-760", 13) == 0)
+		return (TRUE);
+
+	return (FALSE);
+}
